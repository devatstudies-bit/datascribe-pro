    <!-- ══════════════════════════════════════════════════════════ -->
    <mxCell id="1300" value="&lt;b&gt;TYPICAL REQUEST FLOW&lt;/b&gt;  →  &lt;b&gt;[L1]&lt;/b&gt; Auth + session load  →  &lt;b&gt;[L2]&lt;/b&gt; Rate check + provider select  →  &lt;b&gt;[L3]&lt;/b&gt; classify → discover(CACHE) → plan → execute  →  &lt;b&gt;[L5]&lt;/b&gt; Schema context injected  →  &lt;b&gt;[L4]&lt;/b&gt; LLM generates SQL  →  &lt;b&gt;[L6]&lt;/b&gt; AST validates SELECT-only  →  &lt;b&gt;[L7]&lt;/b&gt; Pool executes query  →  &lt;b&gt;[L8]&lt;/b&gt; Span + metrics emitted  →  &lt;b&gt;[L1]&lt;/b&gt; Response streamed"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#1a1a2e;fontSize=10;align=left;verticalAlign=middle;"
