# ── Copy this file to .env and fill in your values ──────────────────────────

# ── Layer 4: LLM Provider ────────────────────────────────────────────────────
# Choose ONE: openai | azure_openai | bedrock
LLM_PROVIDER=openai

# ── Option A: OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_HEAVY=gpt-4o
OPENAI_MODEL_LIGHT=gpt-4o-mini

# ── Option B: Azure OpenAI ───────────────────────────────────────────────────
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_DEPLOYMENT_HEAVY=gpt-4o
# AZURE_DEPLOYMENT_LIGHT=gpt-4o-mini

# ── Option C: AWS Bedrock ────────────────────────────────────────────────────
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# Credentials via IAM role / ~/.aws/credentials — no key needed on AWS infra
# BEDROCK_MODEL_HEAVY=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MODEL_LIGHT=anthropic.claude-3-haiku-20240307-v1:0

# ── Layer 7: Database ────────────────────────────────────────────────────────
# Any SQLAlchemy URI (all connections are READ-ONLY enforced)
DATABASE_URL=sqlite:///data/chinook.db
# DATABASE_URL=postgresql://readonly_user:password@host:5432/mydb
# DATABASE_URL=mssql+pyodbc://readonly_user:password@host/mydb?driver=ODBC+Driver+17+for+SQL+Server

# ── Layer 1: App ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Layer 3: Agent ───────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
MAX_RESULT_ROWS=500
